# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Environment: "development" enables debug-friendly settings; anything else
# (or unset) is treated as production.
APP_ENV=development

# Flask dev server debug (Werkzeug debugger = RCE if exposed). Keep 0 in prod.
FLASK_DEBUG=1

# Flask app entrypoint (used by the `flask` CLI, e.g. `flask db upgrade`).
FLASK_APP=run.py

# --- Core security -----------------------------------------------------------
# Generate a strong random value, e.g.:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Database: Supabase / PostgreSQL ----------------------------------------
# From Supabase dashboard: Project Settings -> Database -> Connection string
# (URI). Use the "Session pooler" (port 5432) or direct connection for a
# long-running web app. Example:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- URL generation (needed by Celery email tasks outside a request) --------
SERVER_NAME=localhost:5050
PREFERRED_URL_SCHEME=http

# --- Mail (Gmail SMTP) -------------------------------------------------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=info@taxlify.app
# Gmail App Password (16 chars). ROTATE the old one that was in source control.
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=info@taxlify.app

# --- Celery / Redis ----------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Uploads -----------------------------------------------------------------
# Max upload size in bytes (default 10 MB).
MAX_CONTENT_LENGTH=10485760

# --- Error monitoring / logging ----------------------------------------------
# Sentry DSN (leave empty to disable Sentry). From sentry.io project settings.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
LOG_LEVEL=INFO
LOG_DIR=logs

# --- AI document intake (optional) -------------------------------------------
# Anthropic API key. Leave empty to disable AI document analysis. From
# console.anthropic.com. ANTHROPIC_MODEL defaults to claude-opus-5; set a
# cheaper model (e.g. claude-haiku-4-5) for high-volume classification.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
